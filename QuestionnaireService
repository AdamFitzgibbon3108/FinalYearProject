package com.example.service;

import com.example.model.Question;
import com.example.model.Response;
import com.example.repository.QuestionRepository;
import com.example.repository.ResponseRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import java.util.List;

@Service
public class QuestionnaireService {

    private final QuestionRepository questionRepository;
    private final ResponseRepository responseRepository;

    @Autowired
    public QuestionnaireService(QuestionRepository questionRepository, ResponseRepository responseRepository) {
        this.questionRepository = questionRepository;
        this.responseRepository = responseRepository;
    }

    /**
     * Retrieves a list of questions based on the user's role.
     * 
     * @param role the role of the user (e.g., "admin", "employee")
     * @return a list of questions relevant to the specified role
     */
    public List<Question> getQuestionsForUserRole(String role) {
        
        return questionRepository.findByRole(role);
    }

    /**
     * Saves a user's response to a question.
     * 
     * @param response the response to save
     * @return the saved Response object
     */
    public Response saveResponse(Response response) {
        return responseRepository.save(response);
    }

    /**
     * Calculates the total score of a user's responses.
     * 
     * @param userId the ID of the user
     * @return the total score for the user's completed questionnaire
     */
    public int calculateUserScore(Long userId) {
        List<Response> responses = responseRepository.findByUserId(userId);
        return responses.stream().mapToInt(Response::getScore).sum();
    }
}
